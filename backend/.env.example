# AI module (translation + 3–5 bullet digests + document Q&A). Without a key the server
# falls back to extractive "key facts" and returns matching passages for questions.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Max AI digests per refresh run (cost cap)
AI_PER_RUN=40
# Source refresh interval, minutes (0 = only manual POST /api/refresh)
REFRESH_MINUTES=30
